{
  "name": "@pte/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "db:migrate": "node --env-file-if-exists=../.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../.env src/db/seed.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pte/shared": "*",
    "cookie": "^1.1.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
